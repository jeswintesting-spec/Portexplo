{
  "name": "portexplo",
  "version": "1.0.0",
  "description": "Local PC file sharing and hosting web application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client-install": "npm install --prefix client",
    "client-build": "npm run build --prefix client",
    "build": "npm run client-build",
    "prod": "npm run build && npm start"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^6.0.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "localtunnel": "^2.0.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
